{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Focus",
  "mainBinaryName": "Focus",
  "version": "0.1.0",
  "identifier": "com.focusaa.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
   "windows": [
  {
    "title": "Focus",
    "width": 1200,
    "height": 800,
    "maximized": true,
    "decorations": false,
    "backgroundColor": "#030407"
  }
],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installerHeader.bmp",
        "sidebarImage": "icons/installerSidebar.bmp",
        "installerHooks": "installer.nsh",
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}